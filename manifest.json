{
  "engine_key": "bennett980_ventocr",
  "engine_api": 3,
  "display_name": "PB980",
  "developer": "VentOCR Developer Team",
  "version": "0.1.5",
  "ventocr_min": "0.6.3",
  "description": "Puritan Bennett 980 ventilator OCR engine (Pressure / Flow / Volume waveforms, VTE)",
  "sample_video": "sample.mp4",
  "supported_resolutions": [
    "3840x2160",
    "1920x1080",
    "1280x720"
  ],
  "has_extract_waves": true,
  "frame_check": false,
  "frame_check_columns": [
    "BM_Best"
  ],
  "output_columns": {
    "frames": [
      "Frame",
      "VTE",
      "Ppeak",
      "BreathMark",
      "BreathMark_char",
      "BM_Best",
      "Sweep_X",
      "BM_Best_conf"
    ],
    "breaths": [
      "BreathNumber",
      "Mode",
      "VTE",
      "VTE_raw",
      "Ppeak",
      "BreathMark_char",
      "Fragmented",
      "Alert"
    ]
  },
  "breath_summary": [
    "Mode",
    "VTE",
    "VTE_raw",
    "Ppeak"
  ],
  "labels": {
    "VTE_raw": "VTE (displayed)"
  },
  "accuracy": {
    "VTE": {
      "method": null,
      "threshold": null,
      "unit": "mL"
    },
    "BreathMark": {
      "method": null,
      "threshold": null
    }
  },
  "outputs": {
    "waves": [
      {
        "name": "Pressure",
        "label": "Paw",
        "unit": "cmH2O",
        "color": "#d62728",
        "scale": {
          "min": "P_min",
          "max": "P_max"
        }
      },
      {
        "name": "Flow",
        "unit": "L/min",
        "color": "#1f77b4",
        "scale": {
          "min": "F_min",
          "max": "F_max"
        }
      },
      {
        "name": "Volume",
        "unit": "mL",
        "color": "#2ca02c",
        "scale": {
          "min": "V_min",
          "max": "V_max"
        }
      }
    ],
    "breath_values": [
      {
        "name": "Mode",
        "label": "Mode (A / C / S)"
      },
      {
        "name": "VTE",
        "unit": "mL",
        "format": "{:.0f}"
      },
      {
        "name": "Ppeak",
        "label": "Ppeak (peak pressure)",
        "unit": "cmH2O",
        "format": "{:.0f}"
      },
      {
        "name": "VTE_raw",
        "label": "VTE (displayed)",
        "unit": "mL",
        "format": "{:.0f}"
      }
    ],
    "alerts": [
      {
        "name": "Fragment",
        "label": "Cut at the right edge of the screen or the first breath of the recording (partial waveform)",
        "exclude_from_accuracy": true
      },
      {
        "name": "Abnormal",
        "label": "Contains frames whose breath icon matches no reference (settings screen, disconnection, etc.)",
        "exclude_from_accuracy": true
      },
      {
        "name": "No Sweep",
        "label": "Sweep line not found; waveform not extracted",
        "exclude_from_accuracy": true
      },
      {
        "name": "Settings Change",
        "label": "Settings screen covered the waveform area",
        "exclude_from_accuracy": true
      },
      {
        "name": "Invalid Range",
        "label": "Could not determine the waveform range",
        "exclude_from_accuracy": true
      },
      {
        "name": "Empty Waveform",
        "label": "Extracted waveform was empty",
        "exclude_from_accuracy": true
      },
      {
        "name": "Frame Read Error",
        "label": "Could not read the end frame image",
        "exclude_from_accuracy": true
      }
    ]
  }
}
